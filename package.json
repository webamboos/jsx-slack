{
  "name": "jsx-slack",
  "version": "7.0.0",
  "description": "Build JSON object for Slack Block Kit surfaces from JSX",
  "keywords": [
    "block-kit",
    "bot",
    "jsx",
    "modal",
    "notification",
    "slack"
  ],
  "homepage": "https://github.com/webamboos/jsx-slack#readme",
  "bugs": {
    "url": "https://github.com/webamboos/jsx-slack/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Webamboos",
    "url": "https://github.com/webamboos"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/webamboos/jsx-slack"
  },
  "files": [
    "dist/"
  ],
  "type": "module",
  "sideEffects": false,
  "module": "dist/src/index.mjs",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.mjs"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/src/jsx-dev-runtime.d.ts",
      "import": "./dist/src/jsx-dev-runtime.mjs"
    },
    "./jsx-runtime": {
      "types": "./dist/src/jsx-runtime.d.ts",
      "import": "./dist/src/jsx-runtime.mjs"
    }
  },
  "scripts": {
    "build": "rimraf dist && rolldown -c",
    "check:audit": "pnpm audit",
    "check:fmt": "oxfmt --check",
    "check:ts": "tsc --noEmit",
    "fmt": "oxfmt",
    "fmt:write": "oxfmt --write",
    "lint": "oxlint",
    "measure-font": "NODE_PATH=$(npm exec --package=puppeteer --cmd \"which puppeteer | xargs dirname | xargs dirname\") node ./tools/measure-font.js",
    "prepack": "pnpm check:ts && pnpm lint && pnpm test:coverage && pnpm build && pnpm types",
    "preversion": "pnpm check:ts && pnpm lint && pnpm test:coverage",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:debug": "vitest --inspect",
    "test:esm": "pnpm build && vitest run test/esm.mjs",
    "types": "tsc --declaration --emitDeclarationOnly --outDir dist",
    "version": "node ./tools/version.js && git add -A CHANGELOG.md"
  },
  "dependencies": {
    "@slack/types": "^2.21.1"
  },
  "devDependencies": {
    "@types/he": "^1.2.3",
    "@vitest/coverage-v8": "^4.0.0",
    "hast-util-to-mdast": "10.1.2",
    "he": "^1.2.0",
    "htm": "^3.1.1",
    "mdast-util-phrasing": "^4.1.0",
    "oxfmt": "latest",
    "oxlint": "latest",
    "rimraf": "^6.1.3",
    "rolldown": "latest",
    "typescript": "^6.0.3",
    "unist-util-parents": "^3.0.0",
    "unist-util-visit": "^5.1.0",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
