{
  "compilerOptions": {
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "jsxImportSource": "jsx-slack",
    "module": "es2022",
    "moduleResolution": "bundler",
    "noImplicitAny": false,
    "paths": {
      "jsx-slack/*": ["./src/*"]
    },
    "resolveJsonModule": true,
    "rootDir": ".",
    "sourceMap": true,
    "strict": true,
    "target": "es2022",
    "noErrorTruncation": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
