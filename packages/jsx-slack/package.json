{
  "name": "@webamboos/jsx-slack",
  "version": "6.1.2",
  "license": "MIT",
  "type": "module",
  "description": "Build JSON object for Slack Block Kit surfaces from JSX",
  "keywords": [
    "block-kit",
    "bot",
    "jsx",
    "modal",
    "notification",
    "slack"
  ],
  "homepage": "https://github.com/webamboos/jsx-slack#readme",
  "bugs": {
    "url": "https://github.com/webamboos/jsx-slack/issues"
  },
  "author": {
    "name": "Webamboos",
    "url": "https://github.com/webamboos"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/webamboos/jsx-slack"
  },
  "files": [
    "dist/"
  ],
  "sideEffects": false,
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.ts",
      "import": "./dist/jsx-dev-runtime.mjs"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.mjs"
    }
  },
  "scripts": {
    "build": "rolldown -c && tsc",
    "check:audit": "pnpm audit",
    "check:fmt": "oxfmt --check",
    "check:ts": "tsc --noEmit",
    "fmt": "oxfmt",
    "fmt:write": "oxfmt --write",
    "lint": "oxlint",
    "prepack": "pnpm check:ts && pnpm lint && pnpm test:coverage && pnpm build && pnpm types",
    "preversion": "pnpm check:ts && pnpm lint && pnpm test:coverage",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:debug": "vitest --inspect",
    "test:esm": "pnpm build && vitest run test/esm.mjs",
    "types": "tsc --emitDeclarationOnly --declaration --outDir dist"
  },
  "dependencies": {
    "@slack/types": "^2.21.1"
  },
  "devDependencies": {
    "@types/he": "^1.2.3",
    "@vitest/coverage-v8": "catalog:",
    "hast-util-to-mdast": "10.1.2",
    "he": "^1.2.0",
    "htm": "^3.1.1",
    "mdast-util-phrasing": "^4.1.0",
    "oxfmt": "latest",
    "oxlint": "latest",
    "rimraf": "^6.1.3",
    "rolldown": "latest",
    "typescript": "catalog:",
    "unist-util-parents": "^3.0.0",
    "unist-util-visit": "^5.1.0",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
