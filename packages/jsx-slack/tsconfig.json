{
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "@webamboos/jsx-slack",
    "module": "es2022",
    "moduleResolution": "bundler",
    "noImplicitAny": false,
    "paths": {
      "@webamboos/jsx-slack/*": ["./*"],
    },
    "resolveJsonModule": true,
    "rootDir": "./src",
    "outDir": "dist",
    "sourceMap": true,
    "strict": true,
    "target": "es2022",
    "noErrorTruncation": true,
    "skipLibCheck": true,
  },
  "include": ["src"],
}
